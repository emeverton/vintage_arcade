# Generate private local values with npm run env:init. Never populate this template.
APP_ENV=local
NODE_ENV=development
PORT=9000
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
MEDUSA_BACKEND_URL=http://localhost:9000
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
COOKIE_SECRET=
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
IFOOD_ENABLED=false
PAYMENTS_LIVE_ENABLED=false
ADS_EXPORT_ENABLED=false
# local/test/staging only. Production remains blocked.
VINTAGE_SLICE_ENABLED=false
# Checkout preview stays off unless explicitly enabled for an isolated environment.
VINTAGE_CHECKOUT_PREVIEW_ENABLED=false
VINTAGE_PREVIEW_SERVICE_SECRET=
VINTAGE_PREVIEW_ORIGIN=
VINTAGE_PREVIEW_BACKEND_URL=
# local/test ephemeral file path. Staging must use VINTAGE_PREVIEW_FIXTURE_JSON instead.
VINTAGE_PREVIEW_FIXTURE_FILE=
# Persistent synthetic fixture JSON for APP_ENV=staging only.
VINTAGE_PREVIEW_FIXTURE_JSON=
# Homologator gate required when APP_ENV=staging.
VINTAGE_STAGING_BASIC_USER=
VINTAGE_STAGING_BASIC_PASSWORD=
# Comma-separated existing Medusa user IDs. Empty means deny all.
# These are server-only grants, never NEXT_PUBLIC/VITE variables.
VINTAGE_DELIVERY_VIEWER_IDS=
VINTAGE_DELIVERY_EDITOR_IDS=
VINTAGE_DELIVERY_PUBLISHER_IDS=
