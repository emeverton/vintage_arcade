# Generate private local values with npm run env:init. Never populate this template.
APP_ENV=local
NODE_ENV=development
PORT=9000
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
MEDUSA_BACKEND_URL=http://localhost:9000
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
COOKIE_SECRET=
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
IFOOD_ENABLED=false
PAYMENTS_LIVE_ENABLED=false
ADS_EXPORT_ENABLED=false
# Explicit opt-in for local/test only, blocked in staging/production.
# Uses synthetic inputs and the system payment simulator, not a PSP sandbox.
VINTAGE_SLICE_ENABLED=false
